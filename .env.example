# DarInsights — environment variables
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; `.env.example` is committed as the canonical reference.

# ---------- Flask core ----------
# Random secret for session signing. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# SQLAlchemy connection string. Defaults to local SQLite if unset.
DATABASE_URL=sqlite:///app.db

# ---------- AI providers ----------
# OpenAI — required for content briefs, drafts, AI answer testing, and website page generation.
OPENAI_API_KEY=

# Perplexity — optional. When set, the AI Answer Monitor fans each
# check out across ChatGPT (training-data answers) and Perplexity
# (web-grounded answers via the `sonar` model), producing one snapshot
# per engine. Get a key at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Tavily — required for web research / competitor discovery.
TAVILY_API_KEY=

# ---------- Webflow publishing ----------
# Required for any Webflow CMS publishing flow.
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=

# Single Pages-style collection used by the legacy generated-website export path.
# Required only if you publish through `/website-builder/project/<id>/publish`.
WEBFLOW_COLLECTION_ID=

# Per-collection IDs used by the multi-collection publishing routes
# (`/client/<id>/website-engine/...`). Each is optional individually,
# but a route returns a "not configured" error if the collection it needs is missing.
WEBFLOW_BLOG_COLLECTION_ID=
WEBFLOW_FAQ_COLLECTION_ID=
WEBFLOW_SERVICE_COLLECTION_ID=
WEBFLOW_LOCATION_COLLECTION_ID=

# When "true", Webflow items are published live immediately after export.
# When "false" (default), items are staged as drafts in Webflow for review.
WEBFLOW_PUBLISH_ON_EXPORT=false

# ---------- Placid visual generation ----------
# Required to enable "Generate Visual" actions on published queue items.
# Sign up at https://placid.app, design a template (with named layers like
# "headline", "subhead", "brand"), then paste the template UUID below.
PLACID_API_TOKEN=
PLACID_TEMPLATE_UUID_OG=

# ---------- Shopify connector ----------
# Required to let workspaces connect a Shopify store via OAuth and pull
# their live product catalog into audits. Create a custom or public app
# in the Shopify Partners dashboard, add the install + callback URLs as
# allowed redirect targets, and copy the credentials below.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated OAuth scopes requested at install time. Defaults
# include write_products to enable one-click fixes (e.g. auto-filling
# alt text on product images). Stores connected before write_products
# was added must be reconnected to upgrade their granted scopes.
SHOPIFY_SCOPES=read_products,read_product_listings,write_products

# Optional: override the OAuth redirect URI (otherwise inferred from the
# request host). Useful for local dev tunnels (ngrok / cloudflared).
SHOPIFY_REDIRECT_URI=

# ---------- Billing (Stripe) ----------
# Required to enable real checkout for credit topups and subscription
# plans. Without these set, the topup buttons + plan CTAs surface a
# "Stripe isn't configured" message rather than 500-ing.
#
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (Stripe dashboard → Developers → Webhooks).
# Point the webhook endpoint at https://your-host/stripe/webhook and
# subscribe to: checkout.session.completed, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# Bundle Price IDs — create one Stripe Price per (credits, tier).
# `_FREE` prices are $2/credit (bought by free-plan users), `_SUB`
# prices are $1/credit (bought by paid subscribers).
STRIPE_PRICE_BUNDLE_5_FREE=
STRIPE_PRICE_BUNDLE_20_FREE=
STRIPE_PRICE_BUNDLE_50_FREE=
STRIPE_PRICE_BUNDLE_5_SUB=
STRIPE_PRICE_BUNDLE_20_SUB=
STRIPE_PRICE_BUNDLE_50_SUB=
STRIPE_PRICE_BUNDLE_100_SUB=

# Subscription Price IDs — create one recurring monthly Stripe Price
# per plan tier. Cancellations are handled automatically via the
# customer.subscription.deleted webhook.
STRIPE_PRICE_PLAN_PLUS=
STRIPE_PRICE_PLAN_PRO=
STRIPE_PRICE_PLAN_GROWTH=

# Extra-workspace add-on Price ID — recurring $9 / month per workspace.
# When unset, the "Add workspace" button on /settings/billing falls
# back to a dev-mode increment (counts up but no real billing).
STRIPE_PRICE_EXTRA_WORKSPACE=

# ---------- Scheduled jobs ----------
# Shared secret for the /cron/answer-monitor endpoint. Set this to a
# long random string and pass it back via the X-Cron-Secret header
# (or ?secret=…) when invoking from your scheduler. Without it, the
# endpoint returns 503.
#   Suggested cron (weekly Monday 08:00):
#     0 8 * * 1 curl -fsS -X POST -H "X-Cron-Secret: $SECRET" \
#                    https://your-host/cron/answer-monitor
CRON_SECRET=
