# ============================================================
# DarInsights — environment variables
# ============================================================
# Copy this file to `.env` and fill in real values. `.env` is git-ignored;
# `.env.example` is committed as the canonical reference.
#
# Each section starts with a [REQUIRED] or [OPTIONAL] tag so you can
# focus on the must-haves first, then layer on integrations.
#
# Anywhere you see a value starting with `your_…` — that's a placeholder
# the code rejects. Real values won't accidentally trigger feature paths.
# ============================================================


# ============================================================
# [REQUIRED] Flask core
# ============================================================

# Random secret for session signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# SQLAlchemy connection string. Defaults to local SQLite if unset.
# Production: managed Postgres (Render / Supabase / RDS / Neon / etc).
# Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///app.db


# ============================================================
# [REQUIRED] AI providers
# ============================================================

# OpenAI — drives content briefs, drafts, AI editing, alt-text vision,
# description rewrites, AI Answer Monitor (default engine), and the
# business-profile extractor. Get a key at:
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Tavily — drives web research / competitor discovery during audits
# and the business-profile enrichment that backs the audit PDF.
# Get a key at: https://tavily.com (free tier covers light usage)
TAVILY_API_KEY=


# ============================================================
# [OPTIONAL] Additional AI engines for the Answer Monitor
# ============================================================
# When set, each Answer Monitor check fans out across every active
# engine and writes one snapshot per (prompt, engine) pair — better
# trend coverage than a single source.

# Perplexity — web-grounded answers (separate signal from training-data
# results). Uses the `sonar` model. Get key at:
#   https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Gemini — Google's AI engine via their OpenAI-compatible endpoint.
# Uses gemini-1.5-flash. Get key at:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=


# ============================================================
# [OPTIONAL but RECOMMENDED for production] Stripe billing
# ============================================================
# Without these, every Buy / Upgrade button surfaces a friendly
# "Stripe isn't configured" flash. The app keeps running unchanged.
#
# Step-by-step setup:
#   1. Sign up at https://stripe.com → Developers → API keys
#   2. Copy the Secret + Publishable keys below
#   3. Create the 12 Stripe Prices listed under STRIPE_PRICE_* below
#      (Products tab → + Add product → set price + recurring/one-time)
#   4. Developers → Webhooks → + Add endpoint
#      Endpoint: https://your-host/stripe/webhook
#      Events: checkout.session.completed, customer.subscription.deleted
#      Copy the signing secret to STRIPE_WEBHOOK_SECRET below

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Credit-bundle Price IDs (one-time payments) ---
# Free-plan tier — bought at $2/credit (no monthly subscription so they
# pay double per credit).
STRIPE_PRICE_BUNDLE_5_FREE=     # one-time, $10.00 → 5 credits
STRIPE_PRICE_BUNDLE_20_FREE=    # one-time, $38.00 → 20 credits
STRIPE_PRICE_BUNDLE_50_FREE=    # one-time, $90.00 → 50 credits

# Subscriber tier (Plus/Pro/Growth) — bought at $1/credit.
STRIPE_PRICE_BUNDLE_5_SUB=      # one-time, $5.00  → 5 credits
STRIPE_PRICE_BUNDLE_20_SUB=     # one-time, $19.00 → 20 credits
STRIPE_PRICE_BUNDLE_50_SUB=     # one-time, $45.00 → 50 credits
STRIPE_PRICE_BUNDLE_100_SUB=    # one-time, $85.00 → 100 credits

# --- Subscription Price IDs (recurring monthly) ---
STRIPE_PRICE_PLAN_PRO=          # recurring monthly, $29  → Pro plan
STRIPE_PRICE_PLAN_GROWTH=       # recurring monthly, $79  → Growth plan

# --- Add-on Price IDs (recurring monthly) ---
# Extra workspace — Plus / Pro / Growth can buy more workspaces beyond
# their plan cap (3 / 3 / 10 respectively).
STRIPE_PRICE_EXTRA_WORKSPACE=   # recurring monthly, $9 / extra workspace

# Extra team seat — Pro / Growth can invite more teammates beyond their
# plan cap (3 / 10 respectively).
STRIPE_PRICE_EXTRA_SEAT=        # recurring monthly, $5 / extra seat

# --- Modular subscription Price IDs (recurring monthly) ---
# Foundation only — these are wired in code (modules.py + webhook
# handler) but not yet surfaced in the dashboard. Fill them in when
# we cut over to the module-based pricing model. See modules.py for
# what each unlocks.
STRIPE_PRICE_MODULE_ACTION_PLAN= # recurring monthly, $19 → Action Plan Automation
STRIPE_PRICE_MODULE_WEBSITE=     # recurring monthly, $29 → Website Module
STRIPE_PRICE_MODULE_ECOMMERCE=   # recurring monthly, $29 → Ecommerce Module
STRIPE_PRICE_MODULE_MARKETPLACE= # recurring monthly, $19 → Marketplace Module
STRIPE_PRICE_MODULE_REAL_DATA=   # recurring monthly, $29 → Real-Data Stack
STRIPE_PRICE_MODULE_AGENCY=      # recurring monthly, $49 → Agency module


# ============================================================
# [OPTIONAL] Google Search Console + Google Analytics
# ============================================================
# Pro/Growth plan workspaces can connect their GSC + GA4 properties.
# One Google OAuth client serves both products via combined scopes.
#
# Setup:
#   1. https://console.cloud.google.com → create / pick a project
#   2. APIs & Services → Library → enable:
#        Google Search Console API
#        Google Analytics Admin API
#        Google Analytics Data API
#   3. APIs & Services → OAuth consent screen → External
#      Add scopes:
#        https://www.googleapis.com/auth/webmasters.readonly
#        https://www.googleapis.com/auth/analytics.readonly
#      Add your own email as a test user (stays in Testing mode)
#   4. APIs & Services → Credentials → + CREATE CREDENTIALS
#      → OAuth client ID → type "Web application"
#      → Authorized redirect URI:
#         https://your-host/integrations/gsc/callback
#   5. Copy the Client ID + Secret below.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — override the redirect URI (otherwise inferred from request).
GOOGLE_OAUTH_REDIRECT_URI=


# ============================================================
# [OPTIONAL] Webflow CMS publishing
# ============================================================
# Get an API token at: https://webflow.com/dashboard/account/integrations
# (workspace-level, with content-manager scope on the target site)

WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=

# Single Pages-style collection used by the legacy generated-website
# export path. Required only if you publish through
# /website-builder/project/<id>/publish.
WEBFLOW_COLLECTION_ID=

# Per-collection IDs used by the multi-collection publishing routes
# (/client/<id>/website-engine/...). Each is optional individually,
# but a route returns "not configured" if the collection it needs
# is missing. Find IDs in Webflow CMS → Collection settings → API.
WEBFLOW_BLOG_COLLECTION_ID=
WEBFLOW_FAQ_COLLECTION_ID=
WEBFLOW_SERVICE_COLLECTION_ID=
WEBFLOW_LOCATION_COLLECTION_ID=

# When "true", Webflow items are published live immediately after export.
# When "false" (default), items are staged as drafts in Webflow for
# review — recommended for client-managed sites.
WEBFLOW_PUBLISH_ON_EXPORT=false


# ============================================================
# [OPTIONAL] Placid visual generation
# ============================================================
# Powers the "Generate Visual" actions on published queue items.
# Sign up at https://placid.app → design a template (with named layers
# like "headline", "subhead", "brand") → paste the template UUID below.

PLACID_API_TOKEN=
PLACID_TEMPLATE_UUID_OG=


# ============================================================
# [OPTIONAL] Shopify connector
# ============================================================
# Lets workspaces connect their Shopify store via OAuth and pull the
# live product catalog into audits + run alt-text / description
# write-back fixes.
#
# Setup:
#   1. https://partners.shopify.com → create a custom or public app
#   2. Add redirect URL:
#        https://your-host/integrations/shopify/callback
#   3. Copy API key + secret below.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated OAuth scopes requested at install time. Default
# includes write_products to enable one-click fixes (alt text + description
# write-back). Stores connected before write_products was added must
# be reconnected to upgrade their granted scopes.
SHOPIFY_SCOPES=read_products,read_product_listings,write_products

# Optional: override the OAuth redirect URI (otherwise inferred from
# the request host). Useful for local dev tunnels (ngrok / cloudflared).
SHOPIFY_REDIRECT_URI=


# ============================================================
# [OPTIONAL but RECOMMENDED for production] Object storage (S3)
# ============================================================
# Required before any multi-instance production deploy — local-disk
# uploads (workspace + agency logos) don't survive a redeploy or
# instance restart. Set S3_BUCKET to enable.
#
# Works with any S3-compatible service: AWS S3, Cloudflare R2,
# Backblaze B2, MinIO. Use S3_ENDPOINT_URL to point at non-AWS hosts.

S3_BUCKET=
S3_REGION=us-east-1

# Provide explicit creds, or rely on the AWS env / instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Public URL prefix served by the bucket (or a fronting CDN). When
# unset, defaults to https://{bucket}.s3.{region}.amazonaws.com —
# fine for default AWS S3 with public-read ACLs. Override for
# CloudFront / R2 custom domains / etc.
S3_PUBLIC_BASE_URL=

# Optional — override for S3-compatible providers (R2, B2, MinIO).
# Example for Cloudflare R2:
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=


# ============================================================
# [OPTIONAL but RECOMMENDED for production] Transactional email
# ============================================================
# Used by team invites + password reset flows. Without these, the app
# falls back to flashing the URL inline so dev can still test.
#
# Two backends — pick one. Resend takes priority when both are set.
#
# --- Option 1: Resend HTTP API (recommended — simpler) ---
# Sign up at https://resend.com → API Keys → "Create API key" (full access).
# Verify your sending domain at https://resend.com/domains before going live.
RESEND_API_KEY=
# Must match a verified sender on the Resend domain. Display name optional.
RESEND_FROM="DarInsights <noreply@yourdomain.com>"
#
# --- Option 2: any SMTP relay (fallback) ---
# Works with AWS SES / SendGrid / Postmark / Mailgun / Gmail App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DarInsights <noreply@yourdomain.com>"
# Set to "false" only if your relay rejects STARTTLS upgrades.
SMTP_TLS=true
# Set to "true" if your relay uses implicit SSL (port 465).
SMTP_SSL=false


# ============================================================
# [OPTIONAL] Cal.com booking integration
# ============================================================
# No server-level keys — Cal.com is a per-workspace integration. The
# user pastes their own API key + Cal.com username from inside the app.
# Listed here for completeness only.


# ============================================================
# [OPTIONAL] WooCommerce connector
# ============================================================
# Same pattern — no server-level keys. Each workspace pastes a
# read-only Consumer Key + Consumer Secret generated in their WP
# admin under WooCommerce → Settings → Advanced → REST API.


# ============================================================
# [OPTIONAL] Scheduled jobs (cron sweep)
# ============================================================
# Shared secret for the /cron/answer-monitor endpoint. Set to a long
# random string and pass it back via X-Cron-Secret header (or ?secret=…)
# when invoking from your scheduler.
#
# Suggested cron entry — weekly Monday 08:00 sweep:
#   0 8 * * 1 curl -fsS -X POST -H "X-Cron-Secret: $CRON_SECRET" \
#                  https://your-host/cron/answer-monitor
#
# Without this set, the endpoint returns 503 (no auto-sweeps run).

CRON_SECRET=
